{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/src/hooks/roadmap_hook.py\" start || python \"${CLAUDE_PLUGIN_ROOT}/src/hooks/roadmap_hook.py\" start", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/src/hooks/roadmap_hook.py\" prompt || python \"${CLAUDE_PLUGIN_ROOT}/src/hooks/roadmap_hook.py\" prompt", "timeout": 5 }
        ]
      }
    ]
  }
}
