# IBM Hackathon — .gitignore
# CRITICAL: Prevents IBM Cloud credentials from being committed to the repo.
# An exposed IBM Cloud API key = IMMEDIATE account suspension.

# ─── Credentials & Secrets ──────────────────────────────────────────────────
.env
.env.*
.env.local
.env.production
credentials.json
ibm-credentials.env
service-credentials.json
*.key
*.pem
*.p12
*.pfx
*.cer
config/secrets.json
config/credentials.json
secrets/
.secrets/

# ─── IBM Cloud ───────────────────────────────────────────────────────────────
ibm_cloud_api_key*
iam_apikey*
apikey*

# ─── Bob IDE (session-local files only) ──────────────────────────────────────
# .bob/ skills and rules ARE committed — they are the product deliverable
# Only the session-local context snapshot is excluded
.bob/context/current-phase.md

# ─── Node.js ─────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/
.next/
.nuxt/

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
venv/
.venv/
env/
ENV/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
htmlcov/
.coverage

# ─── Java / Maven / Gradle ───────────────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
.gradle/
build/

# ─── OS Files ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── IDE Files ───────────────────────────────────────────────────────────────
.idea/
*.swp
*~

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
# ─── Repomix ─────────────────────────────────────────────────────────────────
repomix-output*

# ─── Agent Config ─────────────────────────────────────────────────────────────
.gemini/

phigo_dashboard/
